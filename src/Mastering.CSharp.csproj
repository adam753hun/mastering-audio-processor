<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AssemblyName>MasteringAudioProcessor</AssemblyName>
    <Version>0.2.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../LICENSE" Link="LICENSE"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <EmbeddedResource Include="Resources\*.json" />
    <Content Include="settings*.xml;Presets\*.json;BUILD_INFO.json;THIRD_PARTY_NOTICES.md;LICENSES\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CreatePortableFolders" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)input;$(OutDir)output" />
  </Target>
</Project>
